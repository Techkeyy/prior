# Local Sibyl Memory database (SQLite). Never commit the database file.
PRIOR_MEMORY_DB=data/sibyl-memory.db

# Workspace / tenant isolation inside the Sibyl store.
PRIOR_TENANT_ID=prior-workspace

# Host/port for the local app.
PRIOR_HOST=127.0.0.1
PRIOR_PORT=8787

# Virtuals ACP. Off by default. The app will not invent a worker.
ACP_ENABLED=false
WHITELISTED_WALLET_PRIVATE_KEY=
BUYER_AGENT_WALLET_ADDRESS=
BUYER_ENTITY_ID=
SELLER_AGENT_WALLET_ADDRESS=
SELLER_ENTITY_ID=
ACP_NETWORK=base-mainnet

# Development-only local research worker. Labelled in the UI as not Virtuals.
# Required to exercise hire/deliver without ACP registry credentials.
PRIOR_LOCAL_PROVIDER=false

# Base RPC (optional). Used for an executed onchain action when configured.
BASE_RPC_URL=
BASE_CHAIN_ID=84532
BASE_PRIVATE_KEY=
