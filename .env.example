# Local Sibyl Memory database (SQLite). Never commit the database file.
PRIOR_DATA_DIR=data
PRIOR_MEMORY_DB=data/sibyl-memory.db

# Workspace / tenant isolation inside the Sibyl store.
PRIOR_TENANT_ID=prior-workspace

# Host/port for the local app.
PRIOR_HOST=127.0.0.1
PRIOR_PORT=8787
# Optional deployed source identifier, set by the release deployment.
PRIOR_BUILD_COMMIT=unknown

# Virtuals ACP v2 (@virtuals-protocol/acp-node-v2)
# Privy-managed wallets. SIGNER_PRIVATE_KEY is a Privy authorization key:
# base64 PKCS#8 P-256, typically starts with MIGH. Not an EOA hex key.
ACP_ENABLED=false
ACP_NETWORK=base-mainnet
ACP_JOB_PRICE_USDC=0.01

BUYER_WALLET_ADDRESS=
BUYER_WALLET_ID=
BUYER_SIGNER_PRIVATE_KEY=

SELLER_WALLET_ADDRESS=
SELLER_WALLET_ID=
SELLER_SIGNER_PRIVATE_KEY=

# Development-only research worker. Labelled LOCAL PROVIDER in the UI.
# Never presented as Virtuals. Used while ACP credentials are absent.
PRIOR_LOCAL_PROVIDER=false

# ACP write master switch. Local default stays OFF; the public deployment
# enables it and relies on the product spend policy below instead.
PRIOR_ENABLE_ACP_WRITES=false
# Public spend policy (authoritative server-side). Production: 0.50 / 1.00.
PRIOR_PUBLIC_MAX_JOB_USDC=0.50
PRIOR_PUBLIC_SPEND_LIMIT_USDC=1.00

# Base RPC (optional). Used for an executed onchain action when configured.
BASE_RPC_URL=
BASE_CHAIN_ID=84532
BASE_PRIVATE_KEY=

# Durable identity (Phase 1). Secrets stay out of the repo; production values
# live in /etc/prior/prior.env via the deploy script.
PRIOR_PUBLIC_URL=http://127.0.0.1:8787
PRIOR_COOKIE_SECURE=false
PRIOR_SESSION_TTL_S=7776000
PRIOR_IDENTITY_DB=data/identity.db

# Google OAuth/OIDC (externally gated: create the Web-application client ID
# in Google Cloud Console; see docs/IDENTITY.md). Until set, Google sign-in
# answers 503 and guest mode keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP delivery (externally gated). Until EMAIL_PROVIDER=smtp with a
# real host/sender, /api/auth/email/start reports delivery=not_configured.
EMAIL_PROVIDER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_TLS=ssl
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
